{
  "title": "Week 20 - Autoscaling Study",
  "uid": "serving-study-week20",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inference pressure",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "serving_lab:queue_total{namespace=\"serving-lab\",workload=\"vllm\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Desired replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"serving-lab\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Current replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas{namespace=\"serving-lab\",deployment=\"vllm\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ready replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"serving-lab\",deployment=\"vllm\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Allocated GPU requests",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"serving-lab\",pod=~\"vllm-.*\",resource=\"nvidia_com_gpu\"} and on(namespace,pod) kube_pod_info{node!=\"\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Offered requests",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "serving_study_offered_requests_total{run_id=\"$run_id\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SLO attainment of completed requests",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "serving_study_slo_attainment{run_id=\"$run_id\"}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TTFT p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "serving_study_ttft_p99_ms{run_id=\"$run_id\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "text",
      "title": "Evidence boundary",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Client panels use scripts/serve_platform_metrics.py against a live session; configure the fixed Prometheus to scrape its local /metrics endpoint. Historical JSONL is not automatically backfilled. Missing latency is unknown, never zero. Allocation is not billing. Align the dashboard time range with run.json."
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "run_id",
        "type": "textbox",
        "query": "REPLACE_WITH_RUN_ID"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s"
}
